# Reverse-Proxy mit automatischem HTTPS (Let's Encrypt)

# www → Hauptdomain (Admin-Login und CSRF-Schutz sind an SERVER_URL gebunden)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000

	# Uploads bis 25 MB (siehe payload.config.ts)
	request_body {
		max_size 26MB
	}

	log {
		output stdout
		format console
	}
}
