# ---------------------------------------------------------------
# Schaftböller Ebner – Umgebungsvariablen
# Lokal: als .env kopieren. Produktion: als .env.production (Docker Compose)
# ---------------------------------------------------------------

# Öffentliche Adresse der Website (ohne / am Ende)
SERVER_URL=https://schaftboeller-ebner.at

# Datenbank (lokal). In Docker Compose wird DATABASE_URL automatisch gesetzt.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/sbe
# Nur für Docker Compose: Passwort der Postgres-Datenbank
POSTGRES_PASSWORD=bitte-ein-langes-zufallspasswort

# Geheimer Schlüssel für Sitzungen/Tokens – mindestens 32 zufällige Zeichen (openssl rand -hex 32)
PAYLOAD_SECRET=

# ---- E-Mail-Versand (SMTP) – ohne SMTP_HOST werden Mails nur ins Log geschrieben ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=website@schaftboeller-ebner.at
MAIL_FROM_NAME=Schaftböller Ebner
# Notfall-Empfänger, falls in den Einstellungen keiner hinterlegt ist
INQUIRY_FALLBACK_EMAIL=

# ---- Startinhalte (nur beim allerersten Start) ----
# true = legt Beispielprodukte, Texte, FAQ und Rechtstext-Vorlagen an, falls die Datenbank leer ist
SEED_ON_INIT=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Optional ----
# Anzahl Reverse-Proxys vor der App (für die echte Client-IP im Rate-Limit). Caddy allein = 1
TRUSTED_PROXY_HOPS=1
# Anfragen pro IP in 10 Minuten
RATE_LIMIT_INQUIRIES=5
# Staging/Vorschau nicht von Suchmaschinen indexieren lassen
SITE_NOINDEX=false
# Cookielose Statistik mit Plausible (Build-Argument, siehe docker-compose.yml)
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SCRIPT_URL=
# Medien in S3-kompatiblem Speicher statt im Docker-Volume
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Für Docker Compose mit Caddy (Profil „tls“)
DOMAIN=schaftboeller-ebner.at
